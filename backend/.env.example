DATABASE_URL="postgresql://postgres:password@localhost:5432/chatapp"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
PORT=3000

# Comma-separated browser origins allowed to call the API and Socket.IO
# directly, e.g. "https://app.example.com,https://admin.example.com".
# Native apps and same-origin requests are always allowed (they send no
# Origin header). Leave empty for localhost/LAN-only development; set it in
# production when the web app and API are on different origins. When empty in
# production, no cross-origin browser access is allowed.
CORS_ORIGINS=

# Optional: secret used to sign private upload URLs (defaults to JWT_SECRET)
# and how long those URLs stay valid, in seconds (default 7 days).
FILE_URL_SECRET=
FILE_URL_TTL_SECONDS=604800

# Set to the number of reverse proxies in front of the API (usually 1 behind
# nginx/Render) so auth rate limiting sees the real client IP. Use false when
# the API is exposed directly.
TRUST_PROXY=false

# Auth throttling defaults: 10 logins/15 min per IP (5 per username) and
# 5 registrations/hour per IP. Counters are in-memory and reset on restart.
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_USERNAME_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_LIMIT=5
AUTH_REGISTER_WINDOW_SECONDS=3600
