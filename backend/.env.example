DATABASE_URL="postgresql://postgres:password@localhost:5432/chatapp"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
PORT=3000

# Comma-separated browser origins allowed to call the API and Socket.IO
# directly, e.g. "https://app.example.com,https://admin.example.com".
# Native apps and same-origin requests are always allowed (they send no
# Origin header). Leave empty for localhost/LAN-only development; set it in
# production when the web app and API are on different origins. When empty in
# production, no cross-origin browser access is allowed.
CORS_ORIGINS=

# Optional: secret used to sign private upload URLs (defaults to JWT_SECRET)
# and how long those URLs stay valid, in seconds (default 7 days).
FILE_URL_SECRET=
FILE_URL_TTL_SECONDS=604800

# Set to the number of reverse proxies in front of the API (usually 1 behind
# nginx/Render) so auth rate limiting sees the real client IP. Use false when
# the API is exposed directly.
TRUST_PROXY=false

# Phone OTP sign-in and sign-up (POST /auth/otp/request, /auth/otp/verify,
# /auth/signup). There is no password login: the phone number is the identity.
# Dev-only until an SMS provider is wired: in production (NODE_ENV=production)
# requesting an OTP returns 503 instead of sending anything.
# Codes are stored HMAC-hashed, expire after OTP_TTL_SECONDS, and allow at
# most OTP_MAX_ATTEMPTS wrong entries before the code is invalidated.
# Once the code is verified, a brand-new number gets SIGNUP_TOKEN_TTL_SECONDS
# to finish the username/name steps on POST /auth/signup.
# Throttle: AUTH_OTP_REQUEST_LIMIT per IP and AUTH_OTP_REQUEST_PHONE_LIMIT
# per phone number per AUTH_OTP_WINDOW_SECONDS window.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SIGNUP_TOKEN_TTL_SECONDS=900
AUTH_OTP_REQUEST_LIMIT=5
AUTH_OTP_REQUEST_PHONE_LIMIT=3
AUTH_OTP_VERIFY_LIMIT=10
AUTH_SIGNUP_LIMIT=10
AUTH_OTP_WINDOW_SECONDS=600

# Lifetime of a login session / refresh token, in days.
REFRESH_TOKEN_TTL_DAYS=30

# Optional ClamAV scanning. When enabled, each upload is streamed to clamd
# before it is accepted; if clamd is unreachable the upload fails closed (503).
UPLOAD_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
