datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique
  displayName String?
  password    String
  // Verified mobile number for OTP sign-in. Unique per account; nullable for
  // legacy accounts created before phone login existed.
  phone       String?    @unique
  avatar      String?
  bio         String?
  status    UserStatus @default(OFFLINE)
  createdAt DateTime   @default(now())

  messages       Message[]
  reactions      Reaction[]
  participations ConversationParticipant[]
  reads          MessageRead[]
  sessions       Session[]

  @@map("users")
}

// Short-lived login codes. Only the HMAC of the code is stored, and a new
// request invalidates every unconsumed code for the same phone number.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

// One row per login. Access JWTs carry the session id, so revoking a row
// invalidates its access token immediately (the strategy checks it on every
// request). The refresh token is stored only as a SHA-256 hash.
model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
  @@map("sessions")
}

// A conversation is either a 1-to-1 direct chat (isGroup = false, always
// exactly 2 participants) or a group chat (isGroup = true, name/avatar set).
model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id        String      @id @default(uuid())
  type      MessageType @default(TEXT)
  text      String?
  fileUrl   String?
  fileName  String?
  fileSize  Int?
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime    @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  reactions Reaction[]
  reads     MessageRead[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// Per-user read receipts — required once a conversation can have more than
// two participants (a single `read` boolean on Message can't represent that).
model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

model Reaction {
  id        String  @id @default(uuid())
  emoji     String
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
  @@index([messageId])
  @@map("reactions")
}
