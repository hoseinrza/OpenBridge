datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  // A recording made by a microphone on the spot. An uploaded audio file is
  // AUDIO; the two live on different shelves because one is something you keep
  // and the other is something you listen to where it stands.
  VOICE
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

// What an envelope carries. Both kinds are opaque ciphertext to the server and
// both consume a `seq`, so the ratchet advances the same way either way; the
// kind is what lets unread counts skip the control messages that no one reads
// as chat.
enum E2eeEnvelopeKind {
  MESSAGE
  CONTROL
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique
  // Name parts collected at sign-up. `displayName` is always kept in sync with
  // them (see UsersService.updateProfile / AuthService.completeSignup) because
  // the rest of the app reads a single display name.
  firstName   String?
  lastName    String?
  displayName String?
  password    String
  // Verified mobile number for OTP sign-in. Unique per account; nullable for
  // legacy accounts created before phone login existed.
  phone       String?    @unique
  avatar      String?
  bio         String?
  status      UserStatus @default(OFFLINE)
  createdAt   DateTime   @default(now())

  messages       Message[]
  reactions      Reaction[]
  hides          MessageHide[]
  participations ConversationParticipant[]
  reads          MessageRead[]
  sessions       Session[]
  devices        Device[]
  envelopes      E2eeEnvelope[]
  encryptedBlobs EncryptedBlob[]

  @@map("users")
}

// The ciphertext stream of an end-to-end encrypted conversation: opaque MLS
// messages in the order they were accepted. MLS is not order tolerant, so the
// server's whole job here is a sequenced delivery service — `seq` is assigned
// per conversation with no gaps, and `content` is a base64 blob the server never
// decodes. It cannot tell a Welcome from a chat message and stores no plaintext.
model E2eeEnvelope {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Which account submitted the blob. MLS authenticates the sender inside the
  // ciphertext; this is delivery metadata only, and lets a client skip its own
  // messages without decrypting them.
  senderId       String
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  seq            Int
  content        String           @db.Text
  // Declared by the sending client, so it is delivery metadata rather than
  // something the server can verify: the plaintext inside is what proves a
  // control is a control.
  kind           E2eeEnvelopeKind @default(MESSAGE)
  createdAt      DateTime         @default(now())
  // Set once a device that holds this conversation's keys has decrypted the
  // envelope and written the plaintext back as a Message row. Until then the
  // envelope stays pending: the content is only here, in a form no server can
  // read, and it is reported rather than dropped.
  migratedAt     DateTime?

  @@unique([conversationId, seq])
  @@index([conversationId, kind])
  @@map("e2ee_envelopes")
}

// An attachment the sender encrypted on its own device. The server stores the
// bytes it was handed and never opens them: there is no MIME check, no malware
// scan (nothing readable to scan) and no column that could hold the file's real
// name, type or contents. `conversationId` is the whole access rule — the id
// only ever reaches a member inside their decrypted message, and membership is
// what authorizes a fresh download URL. Size and which chat holds a blob are
// metadata the server does learn; content it cannot.
model EncryptedBlob {
  id             String       @id @default(uuid())
  filename       String       @unique
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  size           Int
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("encrypted_blobs")
}

// One row per installed app that can hold end-to-end encryption keys. The
// client generates `clientId` once per install and reuses it, so registering is
// idempotent; the id is not a secret, only an install handle. Revocation is
// permanent: the row is kept (with revokedAt set) so the same clientId can
// never silently become trusted again.
model Device {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String
  label      String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  keyPackages KeyPackage[]

  @@unique([userId, clientId])
  @@index([userId])
  @@map("devices")
}

// Public MLS KeyPackage blobs handed out to peers so they can add this device
// to a group. The server stores one opaque base64 string plus consumption
// metadata and never parses it — there is deliberately no column that could
// hold a private key, client state, or passphrase. `claimToken` records which
// atomic claim won the row; see E2eeService.claimKeyPackages.
model KeyPackage {
  id         String    @id @default(uuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  content    String    @db.Text
  createdAt  DateTime  @default(now())
  consumedAt DateTime?
  claimToken String?

  @@index([deviceId, consumedAt, createdAt])
  @@index([claimToken])
  @@map("key_packages")
}

// Short-lived login codes. Only the HMAC of the code is stored, and a new
// request invalidates every unconsumed code for the same phone number.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

// One row per login. Access JWTs carry the session id, so revoking a row
// invalidates its access token immediately (the strategy checks it on every
// request). The refresh token is stored only as a SHA-256 hash.
model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  // Which new sessions this session has already been shown, so the alert is
  // per device: one device acknowledging it must not hide it on another.
  securitySeenAt DateTime?
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
  // Pruning and security alerts scan by these two timestamps, not by user.
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

// A conversation is either a 1-to-1 direct chat (isGroup = false, always
// exactly 2 participants) or a group chat (isGroup = true, name/avatar set).
// `e2ee` is one-way for now: turning a direct chat on never turns off, because
// a silent downgrade is a security bug (design doc §7).
// Name, avatar and description are group metadata the server holds in the
// clear even when the chat is encrypted: they are what a member list and a chat
// row are made of, and an encrypted group's messages never appear in them.
model Conversation {
  id          String   @id @default(uuid())
  isGroup     Boolean  @default(false)
  e2ee        Boolean  @default(false)
  name        String?
  avatar      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  envelopes    E2eeEnvelope[]
  blobs        EncryptedBlob[]

  // The chat list filters direct/group and orders by recency.
  @@index([isGroup, updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  // Read state for an encrypted chat is one high-water mark per participant,
  // not a row per message: the transcript is ciphertext the server cannot count
  // as read, and the client only ever needs "everything up to seq N".
  e2eeReadSeq    Int             @default(0)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id            String      @id @default(uuid())
  type          MessageType @default(TEXT)
  text          String?
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  durationMs    Int?
  // The message this one answers. A tombstone target still resolves, so the
  // quote can say «پیام حذف‌شده» instead of losing its place.
  replyToId     String?
  // A forwarded copy names the original author as display metadata. It is not
  // an account link: the source may live in an encrypted chat the server cannot
  // read, so there is nothing stronger to verify here.
  forwardedFrom String?
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  // A row imported from the legacy MLS stream by a device that could decrypt
  // it. The envelope id makes the import idempotent, and the sequence lets a
  // reader deduplicate this row against the local copy it still holds.
  legacyEnvelopeId String?   @unique
  legacySeq        Int?
  // The sender's attachment descriptor, kept verbatim: a blob id plus the key
  // and nonce that open it. The bytes were encrypted on a device, so the server
  // stores this as an opaque record and readers still decrypt the file.
  legacyAttachment Json?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  replyTo Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageReply")

  reactions Reaction[]
  reads     MessageRead[]
  hides     MessageHide[]

  @@index([conversationId, createdAt])
  @@index([conversationId, legacySeq])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

// Per-user read receipts — required once a conversation can have more than
// two participants (a single `read` boolean on Message can't represent that).
model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

// "Delete for me": the row and its ciphertext stay for everyone else, and only
// this viewer stops seeing it. One row per (message, viewer), because a
// message can be hidden by several of its recipients independently — a boolean
// column on Message could only ever mean "hidden by the whole world".
model MessageHide {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_hides")
}

// One reaction per person per message, like a tapback: pressing again removes
// it, pressing a different emoji replaces it. The uniqueness is on the pair
// (user, message) and not on the emoji, because "one person reacted twice with
// two emojis" is exactly what the product rule forbids — a database that allows
// it would let the number on a chip exceed the number of people.
model Reaction {
  id        String   @id @default(uuid())
  emoji     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([messageId])
  @@map("reactions")
}
