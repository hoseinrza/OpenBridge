# Copy to .env and point at your backend. Must be an absolute URL — unlike
# the web app, a mobile device has no "same origin" to resolve a relative
# path against.
#
# - Testing with Expo Go on a physical device on the same LAN as your dev
#   machine: use that machine's LAN IP, not localhost.
# - Testing against the deployed VPS: use its public IP/domain.
EXPO_PUBLIC_API_URL=http://YOUR_SERVER_IP/api
