{
  "expo": {
    "name": "OpenBridge",
    "slug": "openbridge-mobile",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F3EE",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openbridge.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "OpenBridge برای تماس ویدیویی به دوربین نیاز دارد.",
        "NSMicrophoneUsageDescription": "OpenBridge برای تماس صوتی و ویدیویی به میکروفون نیاز دارد."
      }
    },
    "android": {
      "package": "com.openbridge.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#C5161D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "OpenBridge شماره‌های مخاطبین را فقط برای دیدن این که کدام‌شان حساب دارند می‌خواند."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121110",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "OpenBridge برای ضبط پیام صوتی و تماس به میکروفون نیاز دارد."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-asset"
    ]
  }
}
