# Used by docker-compose.yml at the repo root. Copy to `.env` and fill in
# real values before running `docker compose up -d --build`.

POSTGRES_PASSWORD=change-this-strong-password
# Must be at least 32 characters in production; generate with e.g. `openssl rand -base64 48`.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Seals message text and uploaded bytes at rest. Must be base64 that decodes to
# 32 bytes; generate with `openssl rand -base64 32`. Required: the API refuses
# to start without it. Losing it makes existing sealed rows unreadable.
CONTENT_KEY=change-this-to-a-base64-32-byte-key

# Comma-separated browser origins allowed to call the API/Socket.IO directly.
# Leave empty when nginx serves the web app and API on the same origin.
CORS_ORIGINS=

# Port nginx (frontend + reverse proxy) listens on, on the host.
WEB_PORT=80

# Leave as /api unless the frontend and backend are served from different
# domains — then set the backend's full public URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# ── LiveKit (self-hosted WebRTC SFU) ─────────────────────────────────
# The API container uses the internal URL for room administration; browsers use
# the public ws/wss URL. With TLS termination, use wss://example.com/livekit.
LIVEKIT_API_KEY=change-this-livekit-key
LIVEKIT_API_SECRET=change-this-livekit-secret
LIVEKIT_URL=ws://localhost/livekit
LIVEKIT_API_URL=http://livekit:7880

# Call behaviour. Ringing stops after this many seconds; tokens are short-lived
# because they are only needed to establish the room session.
CALL_RING_TIMEOUT_SECONDS=45
CALL_TOKEN_TTL_SECONDS=600
CALL_MAX_DURATION_SECONDS=14400
CALL_MAX_GROUP_PARTICIPANTS=20
